# ADAPT-AI Frontend Configuration
# Do NOT put secret keys or private credentials here.
# Variables prefixed with VITE_ are exposed to the browser.

# Backend API base URL (Default development server address)
VITE_API_BASE_URL=http://localhost:8000

# OpenStreetMap Nominatim and Overpass endpoints (Public open services)
VITE_OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
VITE_OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

