# ADAPT-AI Healthcare Intelligence Platform
# Template only. Copy to .env for local development.
# Never put real secrets in this file.

# Application
APP_ENV=development
APP_NAME="ADAPT-AI Healthcare Intelligence Platform"
VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security
ADAPT_AI_API_KEY=replace_with_a_unique_local_development_key
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
SANITIZE_LOG_PHI=true

# Default jurisdiction
DEFAULT_COUNTRY=IN

# Model provider: hosted, local, or mock_eval
ADAPT_AI_MODEL_PROVIDER=hosted

# Hosted model provider
HOSTED_PROVIDER_TYPE=google
HOSTED_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
HOSTED_MODEL_NAME=gemini-3.5-flash
HOSTED_EMBEDDING_MODEL=gemini-embedding-001
HOSTED_API_KEY=your_gemini_api_key_here

# Optional alternative environment variable names, if supported by the code:
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Local model provider (optional)
LOCAL_MODEL_ENDPOINT=http://localhost:11434/v1
LOCAL_MODEL_NAME=llama3.2:3b

# Request resilience
REQUEST_TIMEOUT_SECONDS=30.0
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=1.5

# Retrieval-Augmented Generation (RAG)
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.65
